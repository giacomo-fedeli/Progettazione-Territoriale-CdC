	partition DIm_Pazienti = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(PercorsoDati & "elaborati\pazienti.xlsx"), null, true),
				    Sheet1_Sheet = Source{[Item="Sheet1",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"id_pz", type text}, {"sesso", Int64.Type}, {"anno_nascita", Int64.Type}, {"anni_compiuti_2022", Int64.Type}}),
				    #"Added Custom" = Table.AddColumn(
				    #"Changed Type",
				    "sesso_descrizione",
				    each if [sesso] = 1 then "Maschio"
				         else if [sesso] = 2 then "Femmina"
				         else null
				),
				    #"Reordered Columns" = Table.ReorderColumns(#"Added Custom",{"id_pz", "sesso", "sesso_descrizione", "anno_nascita", "anni_compiuti_2022"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Reordered Columns",{{"id_pz", "PK_Paziente"}})
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

